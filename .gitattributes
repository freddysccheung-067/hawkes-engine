# The frozen H6 grid carries a SHA-256 in docs/preregistration.md. Git must
# store and restore its bytes exactly, so no line-ending translation applies.
studies/theta0.json -text

# Shell scripts run on Linux runners. Git's autocrlf would store CRLF in the blob
# and Linux would refuse the shebang with "bad interpreter", so these keep LF.
*.sh text eol=lf
